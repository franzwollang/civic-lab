# SQLite file path is resolved relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Optional external OIDC (leave blank to keep prototype IdP-lite only).
# Never commit real secrets — copy to `.env` locally.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8787/api/auth/oidc/callback
# OIDC_SUBJECT_MAP={"alice@example.com":"user-alice"}
# OIDC_JWKS_URI=   # optional; discovery jwks_uri used when unset
# OIDC_MOCK=1
# OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/
