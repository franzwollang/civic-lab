// Civic Lab M1/M3 — editor store entities.
// CONCEPT name is Artifact / ArtifactRevision; Prisma still uses Page /
// PageRevision mapped to `pages` / `page_revisions` until M4 rename.
// Wire JSON keeps `page_id`; API also exposes `/api/artifacts` aliases.
// Prototype sync: `prisma db push` (no migration history yet).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Page {
  pageId             String         @id @map("page_id")
  title              String
  slug               String
  currentRevisionId  String?        @map("current_revision_id")
  createdAt          DateTime       @map("created_at")
  revisions          PageRevision[]

  @@map("pages")
}

model PageRevision {
  revisionId       String   @id @map("revision_id")
  pageId           String   @map("page_id")
  parentRevisionId String?  @map("parent_revision_id")
  createdAt        DateTime @map("created_at")
  author           String
  contentJson      Json     @map("content_json")
  page             Page     @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@index([pageId])
  @@map("page_revisions")
}

/// Singleton registry row (version + items JSON) matching former terms.json.
model TermsRegistry {
  id      Int  @id @default(1)
  version Int
  items   Json

  @@map("terms_registry")
}

/// Singleton registry row matching former attributions.json.
model AttributionsRegistry {
  id      Int  @id @default(1)
  version Int
  items   Json

  @@map("attributions_registry")
}

/// Records that seed data was applied. Absence ⇒ empty DB ⇒ re-seed on startup.
model SeedMeta {
  id        String   @id
  appliedAt DateTime @map("applied_at")
  source    String

  @@map("seed_meta")
}
