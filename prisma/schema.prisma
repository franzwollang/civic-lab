// Civic Lab M4 — Area → Collection → Dossier + editor store entities.
// CONCEPT: Artifact / ArtifactRevision. Physical tables/columns still use
// legacy `pages` / `page_revisions` / `page_id` via @@map / @map during cutover.
// Wire JSON dual-emits `artifact_id` (preferred) + `page_id` (same value).
// Prototype sync: `prisma db push` (no migration history yet).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// CONCEPT §2.0 — `canon` | `manuals`
model Area {
  areaId      String       @id @map("area_id")
  kind        String
  title       String
  collections Collection[]

  @@map("areas")
}

/// CONCEPT §2.0 — Canon singleton; Manuals one per country (`country_code`).
model Collection {
  collectionId String    @id @map("collection_id")
  areaId       String    @map("area_id")
  title        String
  countryCode  String?   @map("country_code")
  summary      String?
  area         Area      @relation(fields: [areaId], references: [areaId], onDelete: Cascade)
  dossiers     Dossier[]

  @@index([areaId])
  @@map("collections")
}

/// CONCEPT §2.1 — subforum-owning semantic unit within a Collection.
model Dossier {
  dossierId    String     @id @map("dossier_id")
  collectionId String     @map("collection_id")
  title        String
  summary      String?
  tags         Json       @default("[]")
  collection   Collection @relation(fields: [collectionId], references: [collectionId], onDelete: Cascade)
  artifacts    Artifact[]

  @@index([collectionId])
  @@map("dossiers")
}

model Artifact {
  artifactId        String             @id @map("page_id")
  title             String
  slug              String
  currentRevisionId String?            @map("current_revision_id")
  createdAt         DateTime           @map("created_at")
  dossierId         String?            @map("dossier_id")
  dossier           Dossier?           @relation(fields: [dossierId], references: [dossierId], onDelete: SetNull)
  revisions         ArtifactRevision[]

  @@index([dossierId])
  @@map("pages")
}

model ArtifactRevision {
  revisionId       String   @id @map("revision_id")
  artifactId       String   @map("page_id")
  parentRevisionId String?  @map("parent_revision_id")
  createdAt        DateTime @map("created_at")
  author           String
  contentJson      Json     @map("content_json")
  artifact         Artifact @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@index([artifactId])
  @@map("page_revisions")
}

/// Singleton registry row (version + items JSON) matching former terms.json.
model TermsRegistry {
  id      Int  @id @default(1)
  version Int
  items   Json

  @@map("terms_registry")
}

/// Singleton registry row matching former attributions.json.
model AttributionsRegistry {
  id      Int  @id @default(1)
  version Int
  items   Json

  @@map("attributions_registry")
}

/// Records that seed data was applied. Absence ⇒ empty DB ⇒ re-seed on startup.
model SeedMeta {
  id        String   @id
  appliedAt DateTime @map("applied_at")
  source    String

  @@map("seed_meta")
}
